  {
   "seq": "10",
   "text": "身こそかく世にもかすまめいかなれは春しる月の朧なるらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "ゆく雁のたよりやまたん老か身も昔の春にかへる世ならは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰丁",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "あかす見てちりにしまゝの出も影にことしは殊に花そまたるゝ",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "へたつるもおなし桜の色なれはよそめいとはぬかつらきの雲",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "たか中の恋のあなたに立ぬらん柳桜の春のにし木々",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "ちらぬまにおりはやつさし山桜おも影はかり家つとにして",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "日かけにはちらぬ木末の桜花嵐にきゆる雪とこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "ぬれもせしはらはて女かむ桜花袖には雪とちりかゝるとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "風さそふ磯山桜ちりぬらし花を残してかへるしら浪",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "花",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "松か枝の今一しほのみとりをもさきて色ます春の藤なき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "から国の九かさねの山吹やいはぬひにはさきはしめけん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "月は猶またり程のよゐのまに光ききたつ庭のうの花",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "さゝかにの雲のはたてや時鳥くへきよひとや空にまたまし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "またるゝをならひになして時鳥あたになかしとねや惜むらん",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "つれなさのたくひならしと有明の月にともなくほとゝきす哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "なをきりにきゝやなさまし時鳥心つくさぬはつねなりせは",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "なく声をいかゝいとはん時鳥物おもふ事はなき身ならねと",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "郭公",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "みしか夜の夕やみなから月影も待いてぬ程にあくる空かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏夜",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "いのりをかむ千歳をかけてもろかつら神のみあれにけふあふひとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "葵",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "いつか又いな葉にきかむ秋の風けふこそ小田のきなへとるなれ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早苗",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "おちたきつ水のみかさも山河もをとまやかなる五月雨の頃",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "五月雨",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "あくる迄さゝて聞はやまきの戸をさてもくゐなのよかやたゝへと",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鶏",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "里遠きわかすむかたのうかひ舟ほしか河辺のかゝり火の影",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜河",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "袖につゝむ蛍のみかはあきらけき君の如くみも身にそ餘れる",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蛍",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "色かへぬ葉もりの神の手向とやさかきにかゝる夕立の雨",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "さはへなす神なひ川のよるの浪よるせやいつこあさのおほぬき",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏抜",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "夏もはやけふに暮ぬとねぬるよのねさめより聞く秋の初風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "たなはたに心をかして天河わか中ならぬ逢瀬をそまつ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "まれなりと恨みねはこそ七夕は年に一夜もたへすあふらめ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "身を秋のわか心よりをきそめてのへにしられぬ袖の夕露",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "西路",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "夜もすからをきてそあかす小山田やねられぬいほの秋の白露",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "西路",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "吹むすふをとさへかなしいはしろの野中の松の秋のはつ風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋風",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "遠き餘る夜のまの露もあさちふのをのか涙と虫やなくらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "虫",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "から衣すそのゝをさゝ分くれてあはてや鹿のつま恨むらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "こしちより身をかき雲に音たてゝさそふ風ありと鴈やきぬらん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雁",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "初雁もおもふかたをやしのふらんなくねにまかふ秋のうら波",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雁",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "月影も神代をかけて増かゝ見みかきいてたる天のかく山",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "雲は見な山風ふきてまきもくのあなしのひはら月そそれる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "ふきをくる時雨の空の秋風にむら雲いそく夜半の月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "村雲のたえまの空をもりすきてくまなきかたにすめる月影",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "なれて見る月はかはらぬ同世にわれのに老のかけそかたふく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "影こほる月の夜寒にをく露を霜にふきなす野への秋風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "月",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "あしたゆく汐くむあまのいとまなみ衣うつよもまとをなるらし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "おく霜にうつろふ菊もけさのまはまた白妙の花とこそ見れ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "菊",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "もみち葉のうつろふ浪の立田川おられぬ水のにしきとや見ん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "宮こをはけふをかきりと帰なりいつこなるらんあさのふる里",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "九月画",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "神音月うたてふりそふ時雨かな涙をたにもいとふたもとに",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "山風のふくにまかせてさためなく木の葉さへふる神無月哉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "行すまもつかへん道の跡はかりうつみなはてそよものもみち葉",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "草葉こそをきそふ霜もたえさらめなにゝ枯ゆくやとの人めそ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "すみすてゝいくよの霜を重ぬらん影すさましき故郷の月",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "池水のこほれる影もひとつにておなし鏡とすめる月かな",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "もろともに色こそかはれ冬枯のあしへのかもの霜のふりはも",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "ふきあけの浜のまさこの汐風にみきはの千鳥跡ものこさす",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千鳥",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "吹しほる風もひとつに音さえてならの葉なからふるあられ哉",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霰",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "ふり積る雪のひかりの白妙にくるゝ空とも見えぬ山のは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "ふみゝ気かあとや尋ねんたかまとのおのへの雪のよるの光に",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "おきつ風ふきこす磯の岩根松なみこそかゝれ雪はたまらす",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "きえもせてつかへまつれは白雪のしらかみまてに身こそふりぬれ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雪",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "見るまゝにしらふになりぬはし鷹のすゝかの山に雪はふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹狩",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "身に年のつもりそふへき時にしも雪さへ何とふりかさぬらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "恋しなむ後のうき名はさもあらはあれ命のうちに人のしらすは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "きえねたゝくゆるおもひの下むけひはては煙の名にもこそたて",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "あふまてはたれゆへおしむ命とていけるを人の猶いとふらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不達恋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "かひなしやつれなき人にたちそはむおもひの煙よそにきえなは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不達恋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "ありはてぬ老の命のならひとや思なされん恋はしぬとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "不達恋",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "うきかたに偽しらぬ心こそちきりしすゑのたのみなりけれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "変恋",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "ほしわひぬをのゝしの原しのひかね人めにあまる袖のしら露",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "顕応",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "かひもあらしうつゝにたのむかぬこともすきて昔の夢になりなは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "契恋",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "まつも又しぬはかりこそくるしけれ契しことはいのちなれとも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待恋",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "かた見かな行もとまるもきぬ〳〵の涙にわくる袖の月かけ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別応",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "有明のうき道芝にきへもせてつれなき露の命なかさよ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "別応",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "おもひ出て後のよをたにとふへくはいきてわするゝ人をうらみし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忘恋",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "恨みてもおもふはかりやしらさらぬいはなゝ程のつらさならねは",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "あらましのわかおもふまゝに夢を見はよしやうつゝの人のつらきも",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "うきかきりみはてぬ程の命こそ我身も人もともになしけれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "恋しさの心を分てなけきこしうきかたにこそ思ひはてぬれ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "さきのよの契あらはにうき中はいつかむくひのかきりなるへき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "恨恋",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "とはすなる人こそあらめ出なしよにわか心たに物わすれすな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶意",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "なからへてうかりしをこそかひなけれとてもたえける中川の水",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶意",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "したわしと思ひはてぬる月日こそたえにし後のわかれなりけれ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "絶意",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "わかためと鳴てや鳥のつけつらんかねて時しる老のねさめを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首暁",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "行水のあはれとおもへつかへこしひとつなかれの関の藤河",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "河",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "きよみかた塩風たかく吹こして浪のしたなるみほのうら松",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "海辺",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "たえて聞かきりやあらぬさひしさになれぬる山の松のあらしも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "月も又露のやとりやたつぬらんかりねの草のおなし枕に",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "こしかたのみゆるまここにならふともたのみかたしやゆく末の夢",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夢",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "何故にそむかさるらんまつ事の身のありてたに戯はれしよを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "つかふへき心はあれととしたけて恨なき身のよをやのかれん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "おしまれぬわか身一はのかるとも世はすてかたし家をおもへは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝",
   "kotobagaki": ""
  },
  {
   "seq": "100",
   "text": "君のよみひなにかたとへん鶴亀も千代万よのおきりありといふ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝",
   "kotobagaki": ""
  },
  {
   "seq": "101",
   "text": "朝霞わか三笠山雲はれてよその夕日の嶺ほのかなり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "遥峰帯晩霞",
   "kotobagaki": ""
  },
  {
   "seq": "102",
   "text": "若菜つむみやこを遠々深山にはまた目にかゝる枝のしら雪",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雪更粘枝",
   "kotobagaki": ""
  },
  {
   "seq": "103",
   "text": "葉かへせぬ心をとめてくれ竹の夜な〳〵霜の春にさゆらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733741",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春浅霜連夜",
   "kotobagaki": ""
  }
 ],
